    "arr = [3,4,2,5,6]\n",
    "pre_sum = [arr[0]]\n",
    "\n",
    "\n",
    "for i in range(1, len(arr)):\n",
    "    sum = pre_sum[i-1]+arr[i]\n",
    "    pre_sum.append(sum)\n",
    "\n",
    "print(pre_sum)\n",
    "\n",
    "print('RangeSum(2,4)',pre_sum[4]- pre_sum [2-1] )"
